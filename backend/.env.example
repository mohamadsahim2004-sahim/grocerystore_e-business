# Copy this file to .env and fill in the values. The real .env is git-ignored - never commit it.

# REQUIRED - the server refuses to start without it. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# MongoDB connection string. Defaults to mongodb://localhost:27017/exotic_store when unset.
MONGO_URI=mongodb://localhost:27017/exotic_store

# Port the API listens on (default 5000). The frontend expects http://localhost:5000/api unless VITE_API_URL is set.
PORT=5000

# Comma-separated browser origins allowed to call the API, e.g. https://shop.example.com
# When empty, ALL origins are allowed - fine for local development, set it in production.
CORS_ORIGIN=http://localhost:5173

# "development" for local work (also required by the development-only PayHere simulator, scripts/simulatePayHereNotify.js).
# Set NODE_ENV=production on a real deployment - live PayHere payments are refused unless it is "production".
NODE_ENV=development

# Optional: token lifetime (default 30d)
# JWT_EXPIRE=30d

# Only used by `node seed/seed.js` to create/promote the first admin account
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Store Admin

# ---------------------------------------------------------------------------
# PayHere checkout. Keep SANDBOX and LIVE values strictly separate - never put live credentials in a development .env.
# The merchant secret lives ONLY here (backend). It is never sent to the browser or returned by any API.
# ---------------------------------------------------------------------------

# --- LOCAL DEVELOPMENT / SANDBOX (PayHere sandbox account: https://sandbox.payhere.lk) ---
# Merchant ID: Side Menu > Integrations. Merchant Secret: shown next to the domain/app you added there
# (the secret is specific to that domain/app).
PAYHERE_SANDBOX=true
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# Where PayHere sends the customer back to the frontend (localhost is fine for these two)
PAYHERE_RETURN_URL=http://localhost:5173/payment/success
PAYHERE_CANCEL_URL=http://localhost:5173/payment/cancel
# PayHere's SERVER calls this, so it must be a PUBLIC https URL. PayHere cannot call localhost: leave it empty during
# local development and use `node scripts/simulatePayHereNotify.js` instead (see PAYHERE_LOCAL_SETUP.md).
PAYHERE_NOTIFY_URL=

# --- LIVE (production deployment only; refused unless NODE_ENV=production) ---
# PAYHERE_SANDBOX=false
# PAYHERE_MERCHANT_ID=<LIVE merchant id>
# PAYHERE_MERCHANT_SECRET=<LIVE merchant secret>
# PAYHERE_RETURN_URL=https://your-shop.example/payment/success
# PAYHERE_CANCEL_URL=https://your-shop.example/payment/cancel
# PAYHERE_NOTIFY_URL=https://your-api.example/api/payments/payhere/notify

# Store prices are in USD; PayHere charges LKR. Keep equal to the LKR rate in frontend/src/config/currency.js (default 331).
# PAYHERE_USD_TO_LKR_RATE=331