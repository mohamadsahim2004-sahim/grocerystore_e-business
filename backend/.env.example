# Copy to .env and fill in. .env is git-ignored - never commit it or share it.

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas (Atlas > Database > Connect > Drivers). Replace <db_password> with the database user's password;
# percent-encode special characters (@ -> %40, : -> %3A, / -> %2F, # -> %23).
# MONGO_URI is also accepted as the variable name.
MONGODB_URI=mongodb+srv://mhdsahim1201_db_user:<db_password>@cluster0.9oa1i3x.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=exotic_store

# REQUIRED. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=30d

# Only used by `node seed/seed.js` to create/promote the first admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Store Admin

# PayHere SANDBOX (https://sandbox.payhere.lk)
PAYHERE_SANDBOX=true
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_RETURN_URL=http://localhost:5173/payment/success
PAYHERE_CANCEL_URL=http://localhost:5173/payment/cancel
# Must be a public https URL; leave empty locally
PAYHERE_NOTIFY_URL=
PAYHERE_USD_TO_LKR_RATE=331

# SMTP for password-reset emails (Gmail needs an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Exotic Grocery Store <you@example.com>