# Copy this file to .env and fill in the values. The real .env is git-ignored - never commit it.

# REQUIRED - the server refuses to start without it. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# MongoDB connection string. Defaults to mongodb://localhost:27017/exotic_store when unset.
MONGO_URI=mongodb://localhost:27017/exotic_store

# Port the API listens on (default 5000). The frontend expects http://localhost:5000/api unless VITE_API_URL is set.
PORT=5000

# Comma-separated browser origins allowed to call the API, e.g. https://shop.example.com
# When empty, ALL origins are allowed - fine for local development, set it in production.
CORS_ORIGIN=http://localhost:5173

# Optional: token lifetime (default 30d) and error detail (set to "development" to include stack traces in API errors)
# JWT_EXPIRE=30d
# NODE_ENV=production

# Only used by `node seed/seed.js` to create/promote the first admin account
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Store Admin

# ---------------------------------------------------------------------------
# PayHere checkout (SANDBOX). Use the Merchant ID + Merchant Secret of your PayHere SANDBOX merchant account (sandbox.payhere.lk)
# The secret lives ONLY here - never in the frontend.
# ---------------------------------------------------------------------------
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
PAYHERE_RETURN_URL=http://localhost:5173/payment/success
PAYHERE_CANCEL_URL=http://localhost:5173/payment/cancel
# Must be PUBLICLY reachable (PayHere's servers call it), e.g. https://api.yourdomain.com/api/payments/payhere/notify
# A localhost URL works for the redirect flow but PayHere cannot notify it, so orders will not be marked paid.
PAYHERE_NOTIFY_URL=
# Store prices are in USD; PayHere charges LKR. Keep equal to the LKR rate in frontend/src/config/currency.js (default 331).
# PAYHERE_USD_TO_LKR_RATE=331